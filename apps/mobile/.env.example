# Plantilla: copia este archivo a apps/mobile/.env.local (gitignored) y ajusta.
# Solo variables publicas (EXPO_PUBLIC_*): viajan dentro del APK, nunca pongas secretos aqui.

# URL base de la API de apps/web que consume la app (sin barra final).
# Aplica al correr `npx expo start` (build de desarrollo). El APK de release la recibe
# como entrada del workflow build-apk.yml (por defecto https://sweetsin.com.au).
EXPO_PUBLIC_API_BASE_URL=https://sweetsin.com.au

# Solo para un build o prebuild local (en GitHub Actions vienen del workflow y de los secretos):
# APP_VARIANT=development
# GOOGLE_MAPS_ANDROID_API_KEY=
