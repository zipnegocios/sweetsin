{
  "expo": {
    "name": "Sweet Sin Staff",
    "slug": "sweetsin-staff",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0F1B3D"
      },
      "predictiveBackGestureEnabled": false,
      "package": "au.com.sweetsin.staff",
      "versionCode": 1
    },
    "plugins": [
      "expo-sqlite",
      "expo-localization",
      "expo-font",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#0F1B3D",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#E63946"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Sweet Sin Staff uses the camera to take your profile photo.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Sweet Sin Staff uses the camera to take a delivery photo.",
          "microphonePermission": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Sweet Sin Staff uses your location to record where a delivery was made.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ]
    ]
  }
}
