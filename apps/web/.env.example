# Plantilla de referencia: copia a .env.local (gitignored) y completa solo lo que uses.
# Nunca pongas valores reales en este archivo.

# --- Base de datos (obligatoria; misma instancia dev=prod) ---
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DBNAME

# --- Auth.js (web) ---
AUTH_SECRET=

# --- API mobile (/api/mobile/**): sin esta variable los handlers lanzan al arrancar ---
MOBILE_JWT_SECRET=

# --- Google: UNA sola clave temporal durante las pruebas ---
# Web (se hornea en el build: tras cambiarla hay que reconstruir)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
# Servidor: ruta y ETA con trafico (Routes API). Nunca NEXT_PUBLIC_*
GOOGLE_ROUTES_API_KEY=

# --- R2 (evidencia de entrega, bucket privado). Solo servidor ---
R2_ACCOUNT_ID=
R2_BUCKET=sweet-delivery
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Opcional (default: delivery-evidence/)
R2_DELIVERY_EVIDENCE_PREFIX=

# --- Stripe (pendiente de credenciales reales) ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- SMTP (pendiente de credenciales reales) ---
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Seed del primer admin (solo al correr el seed) ---
ADMIN_SEED_EMAIL=
ADMIN_SEED_PASSWORD=
